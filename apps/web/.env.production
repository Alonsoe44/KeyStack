# Loaded by `next build` (npm run build / npm run pi:deploy). Not secret.
# The local Pi backend is same-origin in production, so its URL stays unset.

# SongStreamer API on the cloud/server Pi (Tailscale Funnel).
NEXT_PUBLIC_SONGS_API_BASE_URL=https://serverpi.taild695c4.ts.net

# The kiosk is touch-only and its system keyboard cannot show over fullscreen
# Chromium, so always use KeyStack's on-screen keyboard. on | off | auto
NEXT_PUBLIC_ONSCREEN_KEYBOARD=on
