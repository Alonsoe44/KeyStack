# Copy to .env.local (or .env.development.local for `next dev`) and adjust.
# NEXT_PUBLIC_* values are inlined at build time.

# Local Pi backend (apps/server). Empty in production: same origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# SongStreamer API on the cloud/server Pi (song library and audio).
# Its own dev default is http://127.0.0.1:3000, which clashes with `next dev`;
# run one of them on another port. Production builds use the public URL
# from .env.production: https://serverpi.taild695c4.ts.net
NEXT_PUBLIC_SONGS_API_BASE_URL=

# KeyStack's own touch keyboard for text fields: on | off | auto (default:
# shown when the screen has touch and no mouse/trackpad). Production uses on.
NEXT_PUBLIC_ONSCREEN_KEYBOARD=auto
