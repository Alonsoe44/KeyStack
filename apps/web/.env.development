# Only loaded by `next dev`, never by `next build`/`next start` — production
# doesn't need this since apps/server serves both the static build and /api
# from the same origin. This just points the dev server at apps/server's
# default dev port (npm run dev:server) so `npm run dev` works out of the box
# without a manual env var.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
